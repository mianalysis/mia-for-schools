COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GUISeparator" DISABLEABLE="false" ENABLED="true" ID="1786308988" NAME="GUI separator" NICKNAME="Rotate: Activity" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Show in processing view" NICKNAME="Show in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in processing view" NICKNAME="Expanded in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in editing view" NICKNAME="Expanded in editing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="58183211" NAME="Perform action" NICKNAME="Click left" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Perform action" NICKNAME="&lt;img src=&quot;./images/arrow.svg&quot;/ class=&quot;w-12 h-12 p-2 -rotate-90&quot;&gt;" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;currVal = workspace.getMetadata().get(&quot;TranslationX2&quot;);&#10;workspace.getMetadata().put(&quot;TranslationX2&quot;,currVal-1);&#10;" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="1488112664" NAME="Perform action" NICKNAME="Click right" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Perform action" NICKNAME="&lt;img src=&quot;./images/arrow.svg&quot;/ class=&quot;w-12 h-12 p-2 rotate-90&quot;&gt;" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;currVal = workspace.getMetadata().get(&quot;TranslationX2&quot;);&#10;workspace.getMetadata().put(&quot;TranslationX2&quot;,currVal+1);&#10;" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="1466354262" NAME="Perform action" NICKNAME="Click up" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Perform action" NICKNAME="&lt;img src=&quot;./images/arrow.svg&quot;/ class=&quot;w-12 h-12 p-2&quot;&gt;" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;currVal = workspace.getMetadata().get(&quot;TranslationY2&quot;);&#10;workspace.getMetadata().put(&quot;TranslationY2&quot;,currVal-1);&#10;" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="1480004602" NAME="Perform action" NI