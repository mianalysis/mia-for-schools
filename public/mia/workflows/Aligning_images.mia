ARAM NAME="Parameter to display" NICKNAME="Parameter to display" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Text to display" NICKNAME="Text to display" VALUE="&lt;div class=&quot;text-emerald-500 italic text-4xl mb-4&quot;&gt;Light and electrons&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;Scientists can view objects in many different ways.  Here, they have used light to make important parts glow and electrons to see tiny details.&lt;/div&gt;&lt;div class=&quot;mb-4&quot;&gt;For this challenge, the pictures are different sizes as well as being out of position and turned around. Slide, rotate and zoom until the two views line up!&lt;/div&gt;" VISIBLE="false" /></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GUISeparator" DISABLEABLE="false" ENABLED="true" ID="1423628870" NAME="GUI separator" NICKNAME="Scale: Activity" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Show in processing view" NICKNAME="Show in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in processing view" NICKNAME="Expanded in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in editing view" NICKNAME="Expanded in editing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="1041990285" NAME="Perform action" NICKNAME="Click left" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Perform action" NICKNAME="&lt;img src=&quot;./images/arrow.svg&quot;/ class=&quot;w-12 h-12 p-2 -rotate-90&quot;&gt;" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;currVal = workspace.getMetadata().get(&quot;TranslationX3&quot;);&#10;workspace.getMetadata().put(&quot;TranslationX3&quot;,currVal-1);&#10;" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="683487708" NAME="Perform action" NICKNAME="Click right" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Perform action" NICKNAME="&lt;img src=&quot;./images/arrow.svg&quot;/ class=&quot;w-12 h-12 p-2 rotate-90&quot;&gt;" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;currVal = workspace.getMetadata().get(&quot;TranslationX3&quot;);&#10;workspace.getMetadata().put(&quot;TranslationX3&quot;,currVal+1);&#10;" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="2029740791" NAME="Perform action" NICKNAME="Click up" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Perform action" NICKNAME="&lt;img src=&quot;./images/arrow.svg&quot;/ class=&quot;w-12 h-12 p-2&quot;&gt;" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Script language" N