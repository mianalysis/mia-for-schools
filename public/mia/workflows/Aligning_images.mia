le.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;workspace.getMetadata().put(&quot;TranslationX1&quot;,0);&#10;workspace.getMetadata().put(&quot;TranslationY1&quot;,0);&#10;&#10;workspace.getMetadata().put(&quot;TranslationX2&quot;,0);&#10;workspace.getMetadata().put(&quot;TranslationY2&quot;,0);&#10;workspace.getMetadata().put(&quot;Theta2&quot;,0);&#10;&#10;workspace.getMetadata().put(&quot;TranslationX3&quot;,0);&#10;workspace.getMetadata().put(&quot;TranslationY3&quot;,0);&#10;workspace.getMetadata().put(&quot;Theta3&quot;,0);&#10;workspace.getMetadata().put(&quot;Scale3&quot;,1);" VISIBLE="false" /><PARAMETER NAME="Script file" NICKNAME="Script file" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAMETER NAME="Add parameter" NICKNAME="Add parameter" VALUE="" VISIBLE="false"><COLLECTION /></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GUISeparator" DISABLEABLE="false" ENABLED="true" ID="1290092853" NAME="GUI separator" NICKNAME="Intro" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Show in processing view" NICKNAME="Show in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in processing view" NICKNAME="Expanded in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in editing view" NICKNAME="Expanded in editing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.DisplaySimpleImage" DISABLEABLE="false" ENABLED="true" ID="1064090937" NAME="Display simple image" NICKNAME="Display simple image" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add image" NICKNAME="Add image" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Image name" NICKNAME="Image name" SHOW_TEXT="false" VALUE="Cartoon" VISIBLE="false" /></PARAMS></COLLECTION></PARAMETER><PARAMETER NAME="Show probe control" NICKNAME="Show probe control" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Show select control" NICKNAME="Show select control" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Show zoom control" NICKNAME="Show zoom control" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Default control" NICKNAME="Default control" SHOW_TEXT="false" VALUE="Move" VISIBLE="false" /><PARAMETER NAME="About text" NICKNAME="About text" VALUE="Some starter info" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.CreateMessage" DISABLEABLE="false" ENABLED="true" ID="1737199197" NAME="Create message" NICKNAME="Create message" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false" /><PARAM NAME="Graph to display" NICKNAME="Graph to display" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Module" NICKNAME="Module" VALUE="" VISIBLE="false" /><PARAM NAME="Parameter to display" NICKNAME="Parameter to display" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Text to display" NICKNAME="Text to display" VALUE="&lt;div class=&quot;text-emerald-500 italic text-4xl mb-4&quot;&gt;Can you line them up?&lt;/div&gt;&lt;div class=&quot;mb-4&quot;&gt;Scientists use microscopes to explore tiny things, from cells to the parts of our brains.&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;Sometimes, they take several pictures of the same thing, but the pictures don't quite line up. Can you fix them?&lt;/div&gt;&lt;div class=&quot;mb-4&quot;&gt;You'll tackle three image puzzles, learn some scientist skills and earn a star for each one you solve. Let's get exploring!.&lt;/div&gt;" VISIBLE="false" /></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GUISeparator" DISABLEABLE="false" ENABLED="true" ID="237206453" NAME="GUI separator" NICKNAME="Translate: Background" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Show in processing view" NICKNAME="Show in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in processing view" NICKNAME="Expanded in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in editing view" NICKNAME="Expanded in editing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.DisplaySimpleImage" DISABLEABLE="false" ENABLED="true" ID="2115808929" NAME="Display simple image" NICKNAME="Display simple image" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add image" NICKNAME="Add image" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Image name" NICKNAME="Image name" SHOW_TEXT="false" VALUE="Cells" VISIBLE="false" /></PARAMS></COLLECTION></PARAMETER><PARAMETER NAME="Show probe control" NICKNAME="Show probe control" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Show select control" NICKNAME="Show select control" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Show zoom control" NICKNAME="Show zoom control" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Default control" NICKNAME="Default control" SHOW_TEXT="false" VALUE="Move" VISIBLE="false" /><PARAMETER NAME="About text" NICKNAME="About text" VALUE="Yet more info" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.CreateMessage" DISABLEABLE="false" ENABLED="true" ID="174999558" NAME="Create message" NICKNAME="Create message" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Text" VISIBLE="false" /><PARAM NAME="Graph to display" NICKNAME="Graph to display" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Module" NICKNAME="Module" VALUE="" VISIBLE="false" /><PARAM NAME="Parameter to display" NICKNAME="Parameter to display" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Text to display" NICKNAME="Text to display" VALUE="&lt;div class=&quot;text-emerald-500 italic text-4xl mb-4&quot;&gt;A colourful mix-up&lt;/div&gt;&lt;div class=&quot;mb-2&quot;&gt;These pictures show cell walls glowing in two different colours: green and magenta. They should line up, but one has slipped!&lt;/div&gt;&lt;div class=&quot;mb-4&quot;&gt;Your mission is to move the magenta picture up, down, left or right until the cell walls match. No turning or zooming needed. Can you get the two colours to fit together?&lt;/div&gt;" VISIBLE="false" /></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GUISeparator" DISABLEABLE="false" ENABLED="true" ID="899348955" NAME="GUI separator" NICKNAME="Translate: Activity" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Show in processing view" NICKNAME="Show in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in processing view" NICKNAME="Expanded in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /><PARAMETER NAME="Expanded in editing view" NICKNAME="Expanded in editing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="1703325109" NAME="Perform action" NICKNAME="Click left" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Perform action" NICKNAME="&lt;img src=&quot;./images/arrow.svg&quot;/ class=&quot;w-12 h-12 p-2 -rotate-90&quot;&gt;" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;currVal = workspace.getMetadata().get(&quot;TranslationX1&quot;);&#10;workspace.getMetadata().put(&quot;TranslationX1&quot;,currVal-1);&#10;" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.miaserver.modules.PerformAction" DISABLEABLE="false" ENABLED="true" ID="1584930930" NAME="Perform action" NICKNAME="Click right" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Perform action" NICKNAME="&lt;img src=&quot;./images/arrow.svg&quot;/ class=&quot;w-12 h-12 p-2 rotate-90&quot;&gt;" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mian