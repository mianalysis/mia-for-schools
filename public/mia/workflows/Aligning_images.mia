owPath" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="ImagesPath" NICKNAME="ImagesPath" /><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="ThumbnailsPath" NICKNAME="ThumbnailsPath" /><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="WorkflowsPath" NICKNAME="WorkflowsPath" /></METADATA></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GlobalVariables" DISABLEABLE="false" ENABLED="true" ID="1762540259" NAME="Global variables" NICKNAME="Global variables" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add new variable" NICKNAME="Add new variable" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Variable name" NICKNAME="Variable name" VALUE="SSIM_Script" VISIBLE="false" /><PARAM NAME="Variable type" NICKNAME="Variable type" SHOW_TEXT="false" VALUE="Text area" VISIBLE="false" /><PARAM NAME="Variable Boolean" NICKNAME="Variable Boolean" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAM NAME="Variable value" NICKNAME="Variable value" VALUE="" VISIBLE="false" /><PARAM NAME="Variable file" NICKNAME="Variable file" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Variable folder" NICKNAME="Variable folder" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Variable choices" NICKNAME="Variable choices" VALUE="" VISIBLE="false" /><PARAM NAME="Variable choice" NICKNAME="Variable choice" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Store as metadata item" NICKNAME="Store as metadata item" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAM NAME="Variable text" NICKNAME="Variable text" VALUE="// The following two parameters will provide references to the workspace and current module.&#10;#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;import io.github.mianalysis.miaserver.utils.StarCounter;&#10;import ij.process.FloatProcessor;&#10;import ij.process.ImageProcessor;&#10;&#10;red_text = &quot;white&quot;;&#10;orange_box = &quot;white&quot;;&#10;amber_box = &quot;white&quot;;&#10;yellow_box = &quot;white&quot;;&#10;lime_box = &quot;white&quot;;&#10;red_shadow = &quot;&quot;;&#10;orange_shadow = &quot;&quot;;&#10;amber_shadow = &quot;&quot;;&#10;yellow_shadow = &quot;&quot;;&#10;lime_shadow = &quot;&quot;;&#10;message = &quot;Keep trying&quot;;&#10;&#10;if (error &lt; thresh1) {&#10;    red_text = &quot;red-500&quot;;&#10;    red_shadow = &quot;shadow-equal&quot;;&#10;}&#10;&#10;if (error &lt; thresh2) {&#10;    orange_box = &quot;orange-500&quot;;&#10;    orange_shadow = &quot;shadow-equal&quot;;&#10;&#9;message = &quot;That's a good start&quot;;&#10;}&#10;&#10;if (error &lt; thresh3) {&#10;    amber_box = &quot;amber-400&quot;;&#10;    amber_shadow = &quot;shadow-equal&quot;;&#10;&#9;message = &quot;Getting there&quot;;&#10;}&#10;&#10;if (error &lt; thresh4) {&#10;    yellow_box = &quot;yellow-400&quot;;  &#10;    yellow_shadow = &quot;shadow-equal&quot;; &#10;&#9;message = &quot;Almost there&quot;;&#10;}&#10;&#10;if (error &lt; thresh5) {&#10;    lime_box = &quot;lime-500&quot;;&#10;    lime_shadow = &quot;shadow-equal&quot;;&#10;&#9;message = &quot;Well done! Click \&quot;Next\&quot; when ready&quot;;&#10;&#9;workflowName = thisModule.getModules().getAnalysisFilename();&#10;&#9;startIdx = Math.max(0, workflowName.lastIndexOf(&quot;/&quot;)+1);&#10;&#9;endIdx = Math.min(workflowName.length()-1, workflowName.lastIndexOf(&quot;.&quot;));&#10;&#9;workflowName = workflowName.substring(startIdx, endIdx);&#10;&#9;StarCounter.addStar(workflowName + &quot;_&quot; + starName);&#10;}&#10;&#10;workspace.getMetadata().put(&quot;RED_BOX&quot;,red_text);&#10;workspace.getMetadata().put(&quot;ORANGE_BOX&quot;,orange_box);&#10;workspace.getMetadata().put(&quot;AMBER_BOX&quot;,amber_box);&#10;workspace.getMetadata().put(&quot;YELLOW_BOX&quot;,yellow_box);&#10;workspace.getMetadata().put(&quot;LIME_BOX&quot;,lime_box);&#10;workspace.getMetadata().put(&quot;RED_SHADOW&quot;,red_shadow);&#10;workspace.getMetadata().put(&quot;ORANGE_SHADOW&quot;,orange_shadow);&#10;workspace.getMetadata().put(&quot;AMBER_SHADOW&quot;,amber_shadow);&#10;workspace.getMetadata().put(&quot;YELLOW_SHADOW&quot;,yellow_shadow);&#10;workspace.getMetadata().put(&quot;LIME_SHADOW&quot;,lime_shadow);&#10;workspace.getMetadata().put(&quot;MESSAGE&quot;,message);" VISIBLE="false" /></PARAMS></COLLECTION></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GlobalVariables" DISABLEABLE="false" ENABLED="true" ID="1333916229" NAME="Global variables" NICKNAME="Global variables" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Add new variable" NICKNAME="Add new variable" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Variable name" NICKNAME="Variable name" VALUE="LUT1" VISIBLE="false" /><PARAM NAME="Variable type" NICKNAME="Variable type" SHOW_TEXT="false" VALUE="Choice" VISIBLE="false" /><PARAM NAME="Variable Boolean" NICKNAME="Variable Boolean" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAM NAME="Variable value" NICKNAME="Variable value" VALUE="" VISIBLE="false" /><PARAM NAME="Variable file" NICKNAME="Variable file" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Variable folder" NICKNAME="Variable folder" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Variable choices" NICKNAME="Variable choices" VALUE="Blue,Cyan,Green,Magenta,Red,Yellow" VISIBLE="false" /><PARAM NAME="Variable choice" NICKNAME="Variable choice" SHOW_TEXT="false" VALUE="Green" VISIBLE="false" /><PARAM NAME="Store as metadata item" NICKNAME="Store as metadata item" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAM NAME="Variable text" NICKNAME="