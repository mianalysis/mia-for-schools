ed objects" NICKNAME="Associated objects" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Measurement name" NICKNAME="Measurement name" VALUE="" VISIBLE="false" /><PARAM NAME="Object metadata name" NICKNAME="Object metadata name" VALUE="" VISIBLE="false" /><PARAM NAME="Parent name" NICKNAME="Parent name" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Children name" NICKNAME="Children name" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Partners name 1" NICKNAME="Partners name 1" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Partners name 2" NICKNAME="Partners name 2" SHOW_TEXT="false" VALUE="" VISIBLE="false" /></PARAMS><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Metadata" VISIBLE="false" /><PARAM NAME="Output image" NICKNAME="Output image" VALUE="" VISIBLE="false" /><PARAM NAME="Output objects" NICKNAME="Output objects" VALUE="" VISIBLE="false" /><PARAM NAME="Associated image" NICKNAME="Associated image" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Metadata name" NICKNAME="Metadata name" VALUE="M02" VISIBLE="false" /><PARAM NAME="Associated objects" NICKNAME="Associated objects" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Measurement name" NICKNAME="Measurement name" VALUE="" VISIBLE="false" /><PARAM NAME="Object metadata name" NICKNAME="Object metadata name" VALUE="" VISIBLE="false" /><PARAM NAME="Parent name" NICKNAME="Parent name" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Children name" NICKNAME="Children name" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Partners name 1" NICKNAME="Partners name 1" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Partners name 2" NICKNAME="Partners name 2" SHOW_TEXT="false" VALUE="" VISIBLE="false" /></PARAMS><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Metadata" VISIBLE="false" /><PARAM NAME="Output image" NICKNAME="Output image" VALUE="" VISIBLE="false" /><PARAM NAME="Output objects" NICKNAME="Output objects" VALUE="" VISIBLE="false" /><PARAM NAME="Associated image" NICKNAME="Associated image" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Metadata name" NICKNAME="Metadata name" VALUE="M12" VISIBLE="false" /><PARAM NAME="Associated objects" NICKNAME="Associated objects" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Measurement name" NICKNAME="Measurement name" VALUE="" VISIBLE="false" /><PARAM NAME="Object metadata name" NICKNAME="Object metadata name" VALUE="" VISIBLE="false" /><PARAM NAME="Parent name" NICKNAME="Parent name" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Children name" NICKNAME="Children name" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Partners name 1" NICKNAME="Partners name 1" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Partners name 2" NICKNAME="Partners name 2" SHOW_TEXT="false" VALUE="" VISIBLE="false" /></PARAMS></COLLECTION></PARAMETER><PARAMETER NAME="Script mode" NICKNAME="Script mode" SHOW_TEXT="false" VALUE="Script text" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="// The following two parameters will provide references to the workspace and current module.&#10;#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;imHalfW = 256;&#10;imHalfH = 256;&#10;&#10;translationSpeed = 5;&#10;thetaSpeed = 8;&#10;scaleSpeed = 0.05;&#10;&#10;theta = Math.toRadians(Me{Theta3}*thetaSpeed);&#10;scale = 1 + Me{Scale3}*scaleSpeed;&#10;&#10;M00 = scale*Math.cos(theta);&#10;M10 = scale*Math.sin(theta);&#10;M01 = -scale*Math.sin(theta);&#10;M11 = scale*Math.cos(theta);&#10;&#10;tX = imHalfW - M00*imHalfW - M01*imHalfW + Me{TranslationX3}*translationSpeed;&#10;tY = imHalfH - M10*imHalfH - M11*imHalfH + Me{TranslationY3}*translationSpeed;&#10;&#10;workspace.getMetadata().put(&quot;M00&quot;,M00);&#10;workspace.getMetadata().put(&quot;M10&quot;,M10);&#10;workspace.getMetadata().put(&quot;M01&quot;,M01);&#10;workspace.getMetadata().put(&quot;M11&quot;,M11);&#10;workspace.getMetadata().put(&quot;M02&quot;,tX);&#10;workspace.getMetadata().put(&quot;M12&quot;,tY);" VISIBLE="false" /><PARAMETER NAME="Script file" NICKNAME="Script file" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAMETER NAME="Add parameter" NICKNAME="Add parameter" VALUE="" VISIBLE="false"><COLLECTION /></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="M00" NICKNAME="M00" /><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="M01" NICKNAME="M01" /><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="M02" NICKNAME="M02" /><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="M10" NICKNAME="M10" /><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="M11" NICKNAME="M11" /><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="M12" NICKNAME="M12" /></METADATA></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.images.transform.registration.AffineFixedTransform" DISABLEABLE="false" ENABLED="true" ID="49831389" NAME="Affine (fixed transform)" NICKNAME="Affine (fixed transform)" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Input image" NICKNAME="Input image" SHOW_TEXT="false" VALUE="CLEMMoving" VISIBLE="false" /><PARAMETER NAME="Apply to input image" NICKNAME="Apply to input image" SHOW_TEXT="false" VALUE="false" VISIBLE="false" /><PARAMETER NAME="Output image" NICKNAME="Output image" VALUE="CLEMMovingApplied" VISIBLE="false" /><PARAMETER NAME="Transformation" NICKNAME="Transformation" VALUE="Me{M00},Me{M10},Me{M01},Me{M11},Me{M02},Me{M12}" VISIBLE="false" /><PARAMETER NAME="Transformation message" NICKNAME="Transformation message" VALUE="Transforms are expected as comma-separated lists of 6 numbers.  These should be in the order M00, M10, M01, M11, M02, M12, where Mij is the i,jth element of the 2x3 affine transformation matrix." VISIBLE="false" /><PARAMETER NAME="Fill mode" NICKNAME="Fill mode" SHOW_TEXT="false" VALUE="Black" VISIBLE="false" /><PARAMETER NAME="Enable multithreading" NICKNAME="Enable multithreading" SHOW_TEXT="false" VALUE="true" VISIBLE="false" /></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA /></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.script.RunScript" DISABLEABLE="false" ENABLED="true" ID="345928643" NAME="Run script" NICKNAME="Run script" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.2"><PARAMETERS><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Metadata" VISIBLE="false" /><PARAM NAME="Output image" NICKNAME="Output image" VALUE="" VISIBLE="false" /><PARAM NAME="Output objects" NICKNAME="Output objects" VALUE="" VISIBLE="false" /><PARAM NAME="Associated image" NICKNAME="Associated image" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Metadata name" NICKNAME="Metadata name" VALUE="Error3" VISIBLE="false" /><PARAM NAME="Associated objects" NICKNAME="Associated objects" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Measurement name" NICKNAME="Measurement name" VALUE="" VISIBLE="false" /><PARAM NAME="Object metadata name" NICKNAME="Object metadata name" VALUE="" VISIBLE="false" /><PARAM NAME="Parent name" NICKNAME="Parent name" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Children name" NICKNAME="Children name" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Partners name 1" NICKNAME="Partners name 1" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAM NAME="Partners name 2" NICKNAME="Partners name 2" SHOW_TEXT="false" VALUE="" VISIBLE="false" /></PARAMS></COLLECTION></PARAMETER><PARAMETER NAME="Script mode" NICKNAME="Script mode" SHOW_TEXT="false" VALUE="Script text" VISIBLE="false" /><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Beanshell" VISIBLE="false" /><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="// The following two parameters will provide references to the workspace and current module.&#10;#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import io.github.mianalysis.mia.MIA;&#10;&#10;tX = -3;&#10;tY = 0;&#10;tT = -6;&#10;tZ = 8;&#10;&#10;cX = workspace.getMetadata().get(&quot;TranslationX3&quot;);&#10;cY = workspace.getMetadata().get(&quot;TranslationY3&quot;);&#10;cT = workspace.getMetadata().get(&quot;Theta3&quot;);&#10;cZ = workspace.getMetadata().get(&quot;Scale3&quot;);&#10;&#10;dX = tX-cX;&#10;dY = tY-cY;&#10;dT = tT-cT;&#10;dZ = tZ-cZ;&#10;&#10;error = Math.sqrt(dX*dX+dY*dY+dT*dT+dZ*dZ);&#10;&#10;workspace.getMetadata().put(&quot;Error3&quot;,error);&#10;&#10;MIA.log.writeDebug(error);&#10;" VISIBLE="false" /><PARAMETER NAME="Script file" NICKNAME="Script file" SHOW_TEXT="false" VALUE="" VISIBLE="false" /><PARAMETER NAME="Add parameter" NICKNAME="Add parameter" VALUE="" VISIBLE="false"><COLLECTION /></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS /><OBJECT_MEASUREMENTS /><METADATA><METADATUM EXPORT_GLOBAL="true" EXPORT_INDIVIDUAL="true" NAME="Error3" NICKNAME="Error3" /></METADATA></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.script.RunScript" DISABLEABLE="false" ENABLED="true" ID="512339602" NAME="Run script" NICKNAME="Run script" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.2"><PARAMETERS><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Output type" NICKNAME="Output type" SHOW_TEXT="false" VALUE="Metadata" VISIBLE="false" /><PARAM NAME="Ou